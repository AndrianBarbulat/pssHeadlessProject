{
  "name": "pss-headless-cart-summary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-managed Wix Headless cart summary: React + Vite + TypeScript connected to Wix Stores (Products V3) and Wix eCommerce (Cart V2).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wix/ecom": "^1.0.2622",
    "@wix/sdk": "^1.21.18",
    "@wix/stores": "^1.0.970",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
